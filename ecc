# Resolve the cockpit source dir from the content root.
# Prints the path (with trailing backend/shim resolved from it) to stdout,
# or prints an error and returns 1 if not found.
cockpit_src_dir() {
  resolve_content_root
  local src="${CONTENT_ROOT:-}/cockpit"
  if [ -f "$src/backend/cockpit/app.py" ]; then
    echo "$src"
    return 0
  fi
  print_err "Command Deck content not found - run: ecc update (or ecc activate <key>)."
  return 1
}

# Health check.  Test seam: ECC_COCKPIT_HEALTH_CMD overrides the real curl.
cockpit_health() {
  local cmd="${ECC_COCKPIT_HEALTH_CMD:-curl -fsS -m 2 http://127.0.0.1:$COCKPIT_PORT/api/health}"
  $cmd >/dev/null 2>&1
}

# Open browser at URL.  Test seam: ECC_BROWSER_CMD=true to no-op.
open_browser() {
  local url="$1"
  if [ -n "${ECC_BROWSER_CMD:-}" ]; then
    $ECC_BROWSER_CMD "$url" >/dev/null 2>&1 || true
    return 0
  fi
  if cmd.exe /c start "" "$url" >/dev/null 2>&1; then return 0; fi
  if wslview "$url" >/dev/null 2>&1; then return 0; fi
  if powershell.exe -NoProfile -Command "Start-Process '$url'" >/dev/null 2>&1; then return 0; fi
  print_info "Open in your browser: $url"
}

# True if the file is ccstatusline's bare first-run default (model |
# context-length | git-branch | git-changes). We may replace THAT with our
# richer default, but never a config carrying session-cost/context-percentage
# (the user's own, or one we already installed).
_ccstatusline_is_default() {
  [ -f "$1" ] || return 1
  grep -q '"context-length"' "$1" 2>/dev/null \
    && grep -q '"git-changes"' "$1" 2>/dev/null \
    && ! grep -q '"session-cost"' "$1" 2>/dev/null
}

# Install BOTH ccstatusline configs (idempotent):
#   - rich personal CLI line (~/.config/ccstatusline/settings.json) so the CLI
#     shows Model | Ctx | Cost | Total | Session | git instead of the sparse
#     default -- only on a fresh/bare box, never over a personalized config.
#   - curated cockpit (Deck) line. Prefer the generator (inherits the user's
#     element colors); fall back to the shipped static curated config so the Deck
#     NEVER drops to ccstatusline's default model|ctx|git line.
# $1 = shim dir, $2 = backend dir.
cockpit_write_statusline_configs() {
  local shim_dir="$1" backend_dir="$2"
  local personal_cfg="$HOME/.config/ccstatusline/settings.json"
  local cockpit_cfg="$COCKPIT_HOME/ccstatusline.json"

  if [ -f "$shim_dir/ccstatusline-default.json" ] \
     && { [ ! -f "$personal_cfg" ] || _ccstatusline_is_default "$personal_cfg"; }; then
    mkdir -p "$(dirname "$personal_cfg")"
    cp "$shim_dir/ccstatusline-default.json" "$personal_cfg"
  fi

  if [ "${ECC_COCKPIT_SKIP_VENV:-}" != "1" ] && [ -x "$COCKPIT_VENV/bin/python" ]; then
    PYTHONPATH="$backend_dir" COCKPIT_HOME="$COCKPIT_HOME" \
      "$COCKPIT_VENV/bin/python" -m cockpit.shim.gen_statusline_config >/dev/null 2>&1 || true
  fi
  if ! grep -q 'Orchestrator' "$cockpit_cfg" 2>/dev/null; then
    [ -f "$shim_dir/ccstatusline-cockpit.json" ] && cp "$shim_dir/ccstatusline-cockpit.json" "$cockpit_cfg"
  fi
}

# Pre-warm the cockpit environment: COCKPIT_HOME dir, token, venv, shims.
cockpit_setup() {
  local cockpit_src
  cockpit_src=$(cockpit_src_dir) || return 1
  local backend_dir="$cockpit_src/backend"
  local shim_dir="$cockpit_src/shim"

  # 1. COCKPIT_HOME directory
  mkdir -p "$COCKPIT_HOME"
  chmod 700 "$COCKPIT_HOME"

  # 2. Token: create if absent (chmod 600)
  if [ ! -f "$COCKPIT_TOKEN_FILE" ]; then
    python3 -c 'import secrets; print(secrets.token_urlsafe(32))' > "$COCKPIT_TOKEN_FILE"
    chmod 600 "$COCKPIT_TOKEN_FILE"
    print_ok "Command Deck: token created"
  fi

  # 3. Venv: build/rebuild only when requirements.txt sha changes.
  #    Test seam: ECC_COCKPIT_SKIP_VENV=1 skips venv entirely.
  if [ "${ECC_COCKPIT_SKIP_VENV:-}" != "1" ]; then
    local req_file="$backend_dir/requirements.txt"
    local req_sha=""
    [ -f "$req_file" ] && req_sha=$(sha256sum "$req_file" | awk '{print $1}')
    local stored_sha=""
    [ -f "$COCKPIT_REQ_MARKER" ] && stored_sha=$(cat "$COCKPIT_REQ_MARKER")

    if [ ! -x "$COCKPIT_VENV/bin/python" ] || [ "$req_sha" != "$stored_sha" ]; then
      print_info "Command Deck: building Python venv..."
      local venv_cmd="${ECC_COCKPIT_VENV_CMD:-python3 -m venv}"
      if ! $venv_cmd "$COCKPIT_VENV" 2>&1; then
        print_err "Failed to create venv. Try: sudo apt install python3-venv"
        return 1
      fi
      local pip_cmd="${ECC_COCKPIT_PIP_CMD:-$COCKPIT_VENV/bin/pip}"
      if ! "$pip_cmd" install -q -r "$req_file" 2>&1; then
        print_err "pip install failed -- check network connectivity."
        return 1
      fi
      [ -n "$req_sha" ] && echo "$req_sha" > "$COCKPIT_REQ_MARKER"
      print_ok "Command Deck: venv ready"
    fi
  fi

  # 3b. Install the ccstatusline binary so the status line renders in BOTH the CLI
  #     and the Deck. It lands in ~/.npm-global/bin, which statusline-shim.sh adds
  #     to PATH for the non-login Claude statusLine process. Best-effort, idempotent,
  #     test seam (ECC_COCKPIT_SKIP_CCSTATUSLINE=1).
  if [ "${ECC_COCKPIT_SKIP_CCSTATUSLINE:-}" != "1" ] \
     && ! command -v ccstatusline >/dev/null 2>&1 \
     && [ ! -x "$HOME/.npm-global/bin/ccstatusline" ] \
     && command -v npm >/dev/null 2>&1; then
    print_info "Command Deck: installing ccstatusline (status line)..."
    if npm install -g --ignore-scripts --prefix "$HOME/.npm-global" ccstatusline@2.2.19 >/dev/null 2>&1; then
      print_ok "Command Deck: ccstatusline installed"
    else
      print_info "Command Deck: ccstatusline not installed (offline?) -- the status line will populate after: npm install -g --ignore-scripts --prefix ~/.npm-global ccstatusline@2.2.19"
    fi
  fi

  # 4. Copy shims to COCKPIT_HOME (stable paths used in settings.json hooks)
  if [ -f "$shim_dir/emit.sh" ]; then
    cp "$shim_dir/emit.sh" "$COCKPIT_HOME/emit.sh"
    chmod +x "$COCKPIT_HOME/emit.sh"
  fi
  if [ -f "$shim_dir/statusline-shim.sh" ]; then
    cp "$shim_dir/statusline-shim.sh" "$COCKPIT_HOME/statusline-shim.sh"
    chmod +x "$COCKPIT_HOME/statusline-shim.sh"
  fi
  # Stage the wiring helpers in COCKPIT_HOME too, so `ecc uninstall` can unwire the
  # statusLine even after the gated content cache has been removed.
  [ -f "$shim_dir/wire_statusline.py" ] && cp "$shim_dir/wire_statusline.py" "$COCKPIT_HOME/wire_statusline.py"
  [ -f "$shim_dir/merge_hooks.py" ] && cp "$shim_dir/merge_hooks.py" "$COCKPIT_HOME/merge_hooks.py"

  # 5. Install both ccstatusline configs: the rich personal CLI line + the curated
  #    Deck line (with a static fallback). See cockpit_write_statusline_configs.
  cockpit_write_statusline_configs "$shim_dir" "$backend_dir"

  print_ok "Command Deck setup complete (port $COCKPIT_PORT)"
}

# Start the backend server if not already running (idempotent).
cockpit_start() {
  # Already healthy -> idempotent, do not start a second server.
  if cockpit_health; then
    print_info "Command Deck already running on port $COCKPIT_PORT"
    return 0
  fi

  # Stale pidfile check: if the pid is not alive, clean it.
  if [ -f "$COCKPIT_PID_FILE" ]; then
    local old_pid
    old_pid=$(cat "$COCKPIT_PID_FILE" 2>/dev/null || echo "")
    if [ -n "$old_pid" ] && ! kill -0 "$old_pid" 2>/dev/null; then
      rm -f "$COCKPIT_PID_FILE"
    fi
  fi

  local cockpit_src backend_dir
  cockpit_src=$(cockpit_src_dir) || return 1
  backend_dir="$cockpit_src/backend"

  local python="${ECC_COCKPIT_PYTHON:-$COCKPIT_VENV/bin/python}"
  # Fall back to system python3 when venv not built (e.g. ECC_COCKPIT_SKIP_VENV=1 in tests)
  [ -x "$python" ] || python="python3"

  print_info "Starting Command Deck on port $COCKPIT_PORT..."
  (
    cd "$backend_dir"
    PYTHONPATH="$backend_dir" AGENTFORGE_COCKPIT_PORT="$COCKPIT_PORT" \
      setsid nohup "$python" -m cockpit.run >>"$COCKPIT_LOG" 2>&1 &
    echo $! > "$COCKPIT_PID_FILE"
  )

  # Poll health up to ~15s
  local i=0
  while [ $i -lt 15 ]; do
    sleep 1
    if cockpit_health; then
      print_ok "Command Deck running at http://127.0.0.1:$COCKPIT_PORT"
      return 0
    fi
    i=$((i + 1))
  done

  print_err "Command Deck did not start in time.  Log: $COCKPIT_LOG"
  tail -20 "$COCKPIT_LOG" 2>/dev/null >&2 || true
  return 1
}

# Stop the running server via the pidfile.
cockpit_stop() {
  if [ ! -f "$COCKPIT_PID_FILE" ]; then
    print_info "Command Deck: no pidfile at $COCKPIT_PID_FILE (not running or already stopped)"
    return 0
  fi
  local pid
  pid=$(cat "$COCKPIT_PID_FILE" 2>/dev/null || echo "")
  rm -f "$COCKPIT_PID_FILE"
  if [ -z "$pid" ]; then return 0; fi
  if ! kill -0 "$pid" 2>/dev/null; then
    print_info "Command Deck: process $pid already gone"
    return 0
  fi
  kill -TERM "$pid" 2>/dev/null || true
  local i=0
  while [ $i -lt 5 ]; do
    sleep 1
    kill -0 "$pid" 2>/dev/null || { print_ok "Command Deck stopped (pid $pid)"; return 0; }
    i=$((i + 1))
  done
  kill -KILL "$pid" 2>/dev/null || true
  print_ok "Command Deck killed (pid $pid)"
}

cmd_cockpit() {
  local do_setup=false
  local do_stop=false
  local do_status=false
  local do_restart=false
  local no_open=false
  local install_hooks=false
  local uninstall_hooks=false
  local assume_yes=false

  if [ $# -eq 0 ]; then
    # Default: launch (setup + start + browser)
    cockpit_setup || true
    cockpit_start || true
    open_browser "http://127.0.0.1:$COCKPIT_PORT"
    return 0
  fi

  while [ $# -gt 0 ]; do
    case "$1" in
      --setup)           do_setup=true ;;
      --stop)            do_stop=true ;;
      --status)          do_status=true ;;
      --restart)         do_restart=true ;;
      --no-open)         no_open=true ;;
      --install-hooks)   install_hooks=true ;;
      --uninstall-hooks) uninstall_hooks=true ;;
      -y|--yes)          assume_yes=true ;;
      -h|--help)
        echo "Usage: ecc cockpit [--setup|--stop|--status|--restart|--no-open"
        echo "                    |--install-hooks [--yes]|--uninstall-hooks]"
        return 0
        ;;
      *) print_warn "Unknown cockpit flag: $1" ;;
    esac
    shift
  done

  if [ "$do_status" = true ]; then
    if cockpit_health; then
      local pid=""
      [ -f "$COCKPIT_PID_FILE" ] && pid=$(cat "$COCKPIT_PID_FILE" 2>/dev/null || echo "")
      print_ok "Command Deck running on port $COCKPIT_PORT${pid:+ (pid $pid)}"
      print_info "URL: http://127.0.0.1:$COCKPIT_PORT"
    else
      print_info "Command Deck not running (port $COCKPIT_PORT)"
    fi
    return 0
  fi

  if [ "$do_stop" = true ]; then
    cockpit_stop
    return 0
  fi

  if [ "$do_restart" = true ]; then
    cockpit_stop
    cockpit_setup || true
    cockpit_start || true
    open_browser "http://127.0.0.1:$COCKPIT_PORT"
    return 0
  fi

  if [ "$install_hooks" = true ]; then
    local cockpit_src
    cockpit_src=$(cockpit_src_dir) || return 1
    local shim_dir="$cockpit_src/shim"
    local backend_dir="$cockpit_src/backend"
    local settings="$CLAUDE_DIR/settings.json"

    # Ensure settings.json exists
    [ -d "$CLAUDE_DIR" ] || mkdir -p "$CLAUDE_DIR"
    [ -f "$settings" ] || echo '{}' > "$settings"

    if [ "$assume_yes" != true ]; then
      printf "%s" "Wire cockpit hooks + statusLine into $settings? [y/N] "
      local ans; read -r ans
      case "$ans" in
        y|Y|yes|YES) ;;
        *) print_info "Cancelled."; return 0 ;;
      esac
    fi

    print_info "Merging hooks into $settings..."
    COCKPIT_HOME="$COCKPIT_HOME" python3 "$shim_dir/merge_hooks.py" "$settings" || {
      print_warn "Hook merge failed (non-fatal)"
    }

    print_info "Wiring statusLine shim into $settings..."
    COCKPIT_HOME="$COCKPIT_HOME" python3 "$shim_dir/wire_statusline.py" "$settings" || {
      print_warn "StatusLine wire failed (non-fatal)"
    }

    # Install/refresh both ccstatusline configs (rich CLI line + curated Deck line).
    cockpit_write_statusline_configs "$shim_dir" "$backend_dir"

    print_ok "Command Deck hooks installed (idempotent -- re-run safely at any time)"
    return 0
  fi

  if [ "$uninstall_hooks" = true ]; then
    local cockpit_src
    cockpit_src=$(cockpit_src_dir) || return 1
    local shim_dir="$cockpit_src/shim"
    local settings="$CLAUDE_DIR/settings.json"
    if [ -f "$settings" ]; then
      COCKPIT_HOME="$COCKPIT_HOME" python3 "$shim_dir/wire_statusline.py" "$settings" --unwire || true
      print_ok "Command Deck statusLine unhooked"
    fi
    return 0
  fi

  if [ "$do_setup" = true ]; then
    cockpit_setup
    return 0
  fi

  if [ "$no_open" = true ]; then
    cockpit_setup || true
    cockpit_start || true
    print_info "Command Deck URL: http://127.0.0.1:$COCKPIT_PORT"
    return 0
  fi
}

