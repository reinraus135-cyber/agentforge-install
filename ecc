# Resolve the quantlab source tree from the content root.
quantlab_src_dir() {
  resolve_content_root
  local src="${CONTENT_ROOT:-}/quantlab"
  if [ -f "$src/backtest/run.py" ]; then
    echo "$src"
    return 0
  fi
  print_err "Quant Lab content not found - it ships with the Quant Lab SKU."
  print_info "Activate / refresh with: ecc activate <key>  or  ecc update"
  return 1
}

# Deploy the lab source tree into the buyer workspace at $QUANTLAB_HOME.
#
# Update semantics (the buyer EDITS this workspace -- their edits must survive):
#   - config/, strategies/, data/  -> copy-if-absent ONLY (buyer-owned areas;
#     new files from a release still arrive, existing files are never touched)
#   - framework files (backtest/, core/, execution/, ml/, ...) -> refreshed,
#     EXCEPT when the workspace copy was locally modified since we deployed it
#     (3-way sha check against $QUANTLAB_DEPLOY_MANIFEST); then the local copy
#     is saved as <file>.bak before the new version lands.
#   - files removed from a release are left behind in the workspace (no
#     deletion of buyer files, ever).
# sha256 of every buyer-owned file (config/, strategies/) as shipped by PRIOR
# releases. Lets the updater prove a file is "pristine from an older release"
# (safe to refresh) vs buyer work (keep). Append-only across releases; the
# format matches .deployed.sha256 lines. ECC_QUANTLAB_PRIOR_SHAS_EXTRA = test seam.
quantlab_prior_shipped() {
  cat <<'PRIOR'
bf8be480316df5ee924ea42ceb520521a91d552849ddf45398c2d24e708f0c73  strategies/sma_cross/strategy.py
5850bb5f7c8fd5e9b5e2f948fc58e577f8179434389b0a09857801747aa15b74  strategies/sma_cross/backtest_example.py
4bacf7d1dc79da333e7c9e2b70c64b4d6a1a72e9a53bc3648da63163a8224a5c  config/bots.example.toml
PRIOR
  [ -n "${ECC_QUANTLAB_PRIOR_SHAS_EXTRA:-}" ] && printf '%s\n' "$ECC_QUANTLAB_PRIOR_SHAS_EXTRA"
  return 0
}

quantlab_deploy() {
  local src="$1"
  mkdir -p "$QUANTLAB_HOME"
  local new_manifest
  new_manifest=$(mktemp)
  local copied=0 refreshed=0 kept=0 baks=0
  local f rel dest src_sha dest_sha last_sha
  while IFS= read -r -d '' f; do
    rel="${f#"$src"/}"
    case "$rel" in
      *__pycache__*|*.pyc) continue ;;
    esac
    dest="$QUANTLAB_HOME/$rel"
    src_sha=$(sha256sum "$f" | awk '{print $1}')

    if [ ! -f "$dest" ]; then
      printf '%s  %s\n' "$src_sha" "$rel" >> "$new_manifest"
      mkdir -p "$(dirname "$dest")"
      cp "$f" "$dest"
      copied=$((copied + 1))
      continue
    fi
    case "$rel" in
      # Buyer data outputs: never in the release tree, never overwritten. The
      # baseline records what is actually on disk, since nothing was deployed.
      data/trades/*|data/state/*|data/models/*)
        printf '%s  %s\n' "$(sha256sum "$dest" | awk '{print $1}')" "$rel" >> "$new_manifest"
        kept=$((kept + 1))
        continue
        ;;
    esac
    dest_sha=$(sha256sum "$dest" | awk '{print $1}')
    if [ "$dest_sha" = "$src_sha" ]; then
      printf '%s  %s\n' "$src_sha" "$rel" >> "$new_manifest"
      kept=$((kept + 1))
      continue
    fi
    last_sha=""
    [ -f "$QUANTLAB_DEPLOY_MANIFEST" ] && \
      last_sha=$(awk -v r="$rel" '$2==r{print $1; exit}' "$QUANTLAB_DEPLOY_MANIFEST")
    case "$rel" in
      # Buyer-owned (the files docs tell buyers to edit). Refresh ONLY when the
      # current copy is provably pristine: it matches the recorded baseline, or
      # byte-matches a version some prior release shipped (heals baselines that
      # a pre-fix updater recorded wrongly). Anything else is buyer work: keep
      # it untouched and carry the old baseline forward so a later release can
      # still tell pristine from modified. data/fixtures/ is NOT here -- bundled
      # fixtures are framework files and refresh with releases.
      config/*|strategies/*)
        if [ "$dest_sha" = "$last_sha" ] || quantlab_prior_shipped | grep -Fxq "$dest_sha  $rel"; then
          printf '%s  %s\n' "$src_sha" "$rel" >> "$new_manifest"
          cp "$f" "$dest"
          refreshed=$((refreshed + 1))
        else
          # No baseline at all (pre-manifest workspace): record nothing, so the
          # file stays buyer-owned forever rather than being blessed by accident.
          [ -n "$last_sha" ] && printf '%s  %s\n' "$last_sha" "$rel" >> "$new_manifest"
          kept=$((kept + 1))
        fi
        continue
        ;;
    esac
    if [ "$dest_sha" != "$last_sha" ]; then
      # Locally modified (or pre-manifest workspace): never clobber silently.
      cp "$dest" "$dest.bak"
      baks=$((baks + 1))
      print_warn "Locally modified framework file refreshed: $rel (your copy: $rel.bak)"
    fi
    printf '%s  %s\n' "$src_sha" "$rel" >> "$new_manifest"
    cp "$f" "$dest"
    refreshed=$((refreshed + 1))
  done < <(find "$src" -type f -print0)
  mv "$new_manifest" "$QUANTLAB_DEPLOY_MANIFEST"
  local bak_note=""
  [ "$baks" -gt 0 ] && bak_note=", $baks saved as .bak"
  print_ok "Quant Lab workspace: $copied new, $refreshed refreshed, $kept kept$bak_note"
}

# Pre-warm the lab venv (sha-keyed on requirements.txt, cockpit pattern).
# Test seams: ECC_QUANTLAB_SKIP_VENV=1, ECC_QUANTLAB_VENV_CMD, ECC_QUANTLAB_PIP_CMD.
quantlab_venv() {
  [ "${ECC_QUANTLAB_SKIP_VENV:-}" = "1" ] && return 0
  local req_file="$QUANTLAB_HOME/requirements.txt"
  [ -f "$req_file" ] || { print_warn "requirements.txt missing in $QUANTLAB_HOME"; return 1; }
  local req_sha stored_sha=""
  req_sha=$(sha256sum "$req_file" | awk '{print $1}')
  [ -f "$QUANTLAB_REQ_MARKER" ] && stored_sha=$(cat "$QUANTLAB_REQ_MARKER")

  if [ ! -x "$QUANTLAB_VENV/bin/python" ] || [ "$req_sha" != "$stored_sha" ]; then
    print_info "Quant Lab: building Python venv (first run takes a minute)..."
    local venv_cmd="${ECC_QUANTLAB_VENV_CMD:-python3 -m venv}"
    if ! $venv_cmd "$QUANTLAB_VENV" 2>&1; then
      print_err "Failed to create venv. Try: sudo apt install python3-venv"
      return 1
    fi
    local pip_cmd="${ECC_QUANTLAB_PIP_CMD:-$QUANTLAB_VENV/bin/pip}"
    if ! "$pip_cmd" install -q -r "$req_file" 2>&1; then
      print_err "pip install failed -- check network connectivity."
      return 1
    fi
    echo "$req_sha" > "$QUANTLAB_REQ_MARKER"
    print_ok "Quant Lab: venv ready"
  fi
}

quantlab_setup() {
  local src
  src=$(quantlab_src_dir) || return 1
  quantlab_deploy "$src"
  quantlab_venv || return 1
  print_ok "Quant Lab ready at $QUANTLAB_HOME"
}

# Health: workspace + venv + imports + the example-strategy smoke backtest on
# the bundled fixture (no network, no keys). Exits non-zero on any failure.
quantlab_doctor() {
  local fail=0
  print_header "Quant Lab Doctor"

  if [ -d "$QUANTLAB_HOME" ] && [ -f "$QUANTLAB_HOME/requirements.txt" ]; then
    print_ok "workspace: $QUANTLAB_HOME"
  else
    print_err "workspace missing -- run: ecc quantlab --setup"
    return 1
  fi

  local py="${ECC_QUANTLAB_PYTHON:-$QUANTLAB_VENV/bin/python}"
  if [ -x "$py" ] || command -v "$py" >/dev/null 2>&1; then
    print_ok "venv python: $py ($("$py" --version 2>&1))"
  else
    print_err "venv python missing -- run: ecc quantlab --setup"
    return 1
  fi

  if (cd "$QUANTLAB_HOME" && PYTHONPATH="$QUANTLAB_HOME" "$py" - <<'PYEOF'
import backtest.run, backtest.synth, backtest.walkForward
import core.bots_config, core.llm_review, core.position_tracker, core.order_submission
import execution.adapters.paper, execution.risk.engine
import ml.engine, ml.model, ml.reviewer
import datafeed.ws_client, agents.base, indicators.core, notifications.telegram
import strategies.sma_cross.strategy, strategies.sma_cross.backtest_example
PYEOF
  ); then
    print_ok "imports: all lab packages load"
  else
    print_err "imports failed -- venv out of date? Run: ecc quantlab --setup"
    fail=1
  fi

  if [ "$fail" -eq 0 ]; then
    print_info "smoke backtest (bundled synthetic fixture)..."
    if (cd "$QUANTLAB_HOME" && PYTHONPATH="$QUANTLAB_HOME" "$py" -m strategies.sma_cross.backtest_example); then
      print_ok "smoke backtest: pipeline green"
    else
      print_err "smoke backtest failed"
      fail=1
    fi
  fi

  if [ "$fail" -eq 0 ]; then
    print_info "ML smoke (tiny walk-forward on the bundled fixture)..."
    if (cd "$QUANTLAB_HOME" && PYTHONPATH="$QUANTLAB_HOME" "$py" -m core.ml_runner --selftest); then
      print_ok "ML smoke: walk-forward pipeline green"
    else
      print_err "ML smoke failed -- sklearn or the runner is unhappy on this box"
      fail=1
    fi
  fi

  if [ "$fail" -ne 0 ]; then
    print_err "Quant Lab doctor found problems"
    return 1
  fi
  print_ok "Quant Lab healthy"
}

cmd_quantlab() {
  require_jq
  local do_setup=false do_update=false do_doctor=false
  if [ $# -eq 0 ]; then
    do_setup=true
  fi
  while [ $# -gt 0 ]; do
    case "$1" in
      --setup)  do_setup=true ;;
      --update) do_update=true ;;
      --doctor) do_doctor=true ;;
      -h|--help)
        echo "Usage: ecc quantlab [--setup|--update|--doctor]"
        echo "  --setup   Deploy the lab to $QUANTLAB_HOME + build its venv"
        echo "  --update  Re-deploy after 'ecc update' (your edits are kept;"
        echo "            modified framework files are saved as .bak first)"
        echo "  --doctor  Health check + offline smoke backtest"
        return 0
        ;;
      *) print_warn "Unknown quantlab flag: $1" ;;
    esac
    shift
  done

  # Quant Lab ships in Pro (as a showcase) and the legacy Quant Lab SKU.
  local owned_sku
  owned_sku=$(detect_sku)
  if ! check_sku_access "pro" "$owned_sku"; then
    print_warn "Quant Lab is a Pro feature (you have: $owned_sku)"
    print_info "Buy at: $(manifest_buy_url)"
    return 1
  fi

  if [ "$do_setup" = true ] || [ "$do_update" = true ]; then
    quantlab_setup || return 1
    if [ "$do_setup" = true ]; then
      echo ""
      print_info "Quickstart:"
      print_info "  cd $QUANTLAB_HOME"
      print_info "  .venv/bin/python -m strategies.sma_cross.backtest_example   # full pipeline"
      print_info "  .venv/bin/python -m strategies.sma_cross.paper_replay      # live exit plumbing"
      print_info "  .venv/bin/python -m pytest tests/ -q                       # the shipped test suite"
      print_info "  ecc cockpit    # then switch to the Trading Deck (top-left, next to the logo)"
      print_info "Docs: $QUANTLAB_HOME/docs/README.md"
    fi
  fi
  if [ "$do_doctor" = true ]; then
    quantlab_doctor || return 1
  fi
}

# -- Uninstall: remove only ECC's footprint, never the user's own ~/.claude --
cmd_uninstall() {
  local assume_yes=false
  while [ $# -gt 0 ]; do
    case "$1" in
      -y|--yes|--force) assume_yes=true ;;
      -h|--help) echo "Usage: ecc uninstall [--yes]"; return 0 ;;
      *) print_warn "Unknown flag: $1" ;;
    esac
    shift
  done

  if [ ! -f "$REGISTRY_FILE" ]; then
    print_warn "No AgentForge install found (no registry at $REGISTRY_FILE)."
    print_info "Nothing to uninstall."
    return 0
  fi

  local n_skills n_agents n_templates sec_present=false
  n_skills=$(registry_list skills | grep -c . || true)
  n_agents=$(registry_list agents | grep -c . || true)
  n_templates=$(registry_list templates | grep -c . || true)
  if jq -e '.features // [] | index("security_hardening")' "$REGISTRY_FILE" >/dev/null 2>&1 || [ -d "$HOME/scripts/security" ]; then
    sec_present=true
  fi

  print_header "Uninstall AgentForge"
  echo "This removes ECC-installed content only:"
  echo "  - $n_skills skills      ($CLAUDE_DIR/skills/)"
  echo "  - $n_agents agents      ($CLAUDE_DIR/agents/, ECC's only)"
  echo "  - rule files            ($CLAUDE_DIR/rules/ecc/)"
  echo "  - $n_templates templates   ($CLAUDE_DIR/templates/)"
  echo "  - ECC config + license  ($ECC_CONFIG)"
  echo "  - installer shell lines (~/.bashrc PATH + API key export)"
  [ "$sec_present" = true ] && echo "  - Pro security hardening (scripts, daily cron, FIM baseline, env sourcing)"
  [ -d "$COCKPIT_HOME" ] && echo "  - Command Deck runtime  ($COCKPIT_HOME + launchers + settings wiring)"
  echo ""
  echo "Your own Claude skills, agents, and login are preserved."
  echo "Claude Code itself is NOT removed (npm uninstall -g @anthropic-ai/claude-code)."

  if [ "$assume_yes" != true ]; then
    printf "%s" "Proceed with uninstall? [y/N] "
    local ans; read -r ans
    case "$ans" in
      y|Y|yes|YES) ;;
      *) print_info "Uninstall cancelled."; return 0 ;;
    esac
  fi

  # 1. ECC-installed skills (flat at ~/.claude/skills/<name>/)
  local item
  while IFS= read -r item; do
    [ -n "$item" ] && rm -rf "$CLAUDE_DIR/skills/$item"
  done < <(registry_list skills)

  # 2. ECC-installed agents -- registry-tracked only, never the user's own
  while IFS= read -r item; do
    [ -n "$item" ] && rm -f "$CLAUDE_DIR/agents/$item.md"
  done < <(registry_list agents)

  # 3. ECC-installed template metadata
  while IFS= read -r item; do
    [ -n "$item" ] && rm -rf "$CLAUDE_DIR/templates/$item"
  done < <(registry_list templates)

  # 4. Rules tree (installed wholesale by install_rules_all)
  rm -rf "$CLAUDE_DIR/rules/ecc"

  # 5. Clean any old nested ecc skills dir (migration: pre-flat-install remnants)
  rm -rf "$CLAUDE_DIR/skills/ecc" 2>/dev/null || true

  # 5b. Pro security hardening footprint -- otherwise the daily cron keeps firing and
  #     ~/.bashrc keeps sourcing security.env after the product is "uninstalled".
  if [ "$sec_present" = true ]; then
    rm -rf "$HOME/scripts/security" "$HOME/.local/security-tools" "$HOME/.secrets/.fim-baseline"
    rm -f "$HOME/.secrets/security.env" "$HOME/.secrets/audit.log" "$HOME/.local/bin/pip-audit"
    # crontab is user-global (HOME does not sandbox it); seam-overridable so tests never touch the real crontab.
    local _crontab="${ECC_CRONTAB_CMD:-crontab}"
    if "$_crontab" -l 2>/dev/null | grep -q 'daily-audit.sh'; then
      "$_crontab" -l 2>/dev/null | grep -v 'daily-audit.sh' | grep -v 'AgentForge daily security audit' | "$_crontab" - 2>/dev/null || true
    fi
    sed -i '/^# --- AgentForge security secrets ---$/,/^# --- end security secrets ---$/d' "$HOME/.bashrc" 2>/dev/null || true
  fi

  # 5b2. Command Deck (cockpit) footprint. Restore the user's statusLine and drop the
  #      cockpit hooks BEFORE removing the runtime, so an opt-in wiring never leaves a
  #      dangling statusLine command (which would break the CLI status line) or dead hooks.
  local _settings="$CLAUDE_DIR/settings.json"
  if [ -f "$_settings" ]; then
    local _wire=""
    [ -f "$COCKPIT_HOME/wire_statusline.py" ] && _wire="$COCKPIT_HOME/wire_statusline.py"
    if [ -z "$_wire" ]; then
      local _src; _src=$(cockpit_src_dir 2>/dev/null) && [ -f "$_src/shim/wire_statusline.py" ] && _wire="$_src/shim/wire_statusline.py"
    fi
    [ -n "$_wire" ] && COCKPIT_HOME="$COCKPIT_HOME" python3 "$_wire" "$_settings" --unwire >/dev/null 2>&1 || true
    # Drop cockpit hook entries (command references ~/.agentforge/cockpit); keep all others.
    if command -v jq >/dev/null 2>&1; then
      local _t; _t=$(mktemp)
      if jq 'if .hooks then .hooks |= with_entries(.value |= (if type=="array" then map(select(((.hooks // []) | map(.command // "") | any(contains("agentforge/cockpit"))) | not)) else . end)) else . end' "$_settings" > "$_t" 2>/dev/null; then
        mv "$_t" "$_settings"
      else
        rm -f "$_t"
      fi
    fi
  fi
  rm -rf "$COCKPIT_HOME"
  rm -f "$HOME/.agentforge-cockpit" "$HOME/.agentforge-claude"
  rmdir "$HOME/.agentforge" 2>/dev/null || true

  # 5c. Release this device's activation slot at LemonSqueezy BEFORE deleting the
  #     license file (which holds the instance_id). Best-effort; never blocks teardown.
  print_info "Releasing device activation slot..."
  license_deactivate_api

  # 6. ECC config (registry, license, cache, .install-complete)
  rm -rf "$ECC_CONFIG"

  # 7. Strip the installer's shell-rc additions: each is a distinctive comment
  #    line followed by its export line, so delete the comment + the next line.
  local rc
  for rc in "$HOME/.bashrc" "$HOME/.profile" "$HOME/.bash_profile"; do
    [ -f "$rc" ] || continue
    sed -i \
      -e '/^# AgentForge -- Anthropic API key$/{N;d;}' \
      -e '/^# AgentForge$/{N;d;}' \
      "$rc" 2>/dev/null || true
  done

  # 8. Installer-managed API key secret (file only, not the ~/.secrets dir)
  rm -f "$HOME/.secrets/anthropic_api_key"

  print_ok "AgentForge has been uninstalled."
  [ "$sec_present" = true ] && print_info "Security hardening removed (npm ignore-scripts + .gitignore entries kept as safe defaults)."
  print_info "Your own Claude config and login were left untouched."
}

# -- Entry point --
main() {
  case "${1:-help}" in
    install)   shift; cmd_install "$@" ;;
    update)    cmd_update ;;
    list)      shift; cmd_list "$@" ;;
    doctor)    shift; cmd_doctor "$@" ;;
    activate)  shift; cmd_activate "$@" ;;
    status)    shift; cmd_status "$@" ;;
    security)  shift; cmd_security "$@" ;;
    cockpit)   shift; cmd_cockpit "$@" ;;
    quantlab)  shift; cmd_quantlab "$@" ;;
    uninstall) shift; cmd_uninstall "$@" ;;
    version)   echo "ecc v$ECC_VERSION" ;;
    help|--help|-h) cmd_help ;;
    *)         print_err "Unknown command: $1"; cmd_help; exit 1 ;;
  esac
}

main "$@"
